<Window x:Class="AttendanceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attendance" Height="500" Width="720"
        MinHeight="400" MinWidth="550"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Course -->
            <RowDefinition Height="Auto"/>
            <!-- Schedule -->
            <RowDefinition Height="Auto"/>
            <!-- Table (DataGrid) -->
            <RowDefinition Height="*"/>
            <!-- Save Button -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Course Selector -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Course" VerticalAlignment="Center" FontWeight="Normal" FontSize="14"/>
            <ComboBox Grid.Column="1" x:Name="cbCourse" Height="30" VerticalContentAlignment="Center"
                      SelectionChanged="cbCourse_SelectionChanged"/>
        </Grid>

        <!-- Schedule Selector -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Content="Schedule" VerticalAlignment="Center" FontWeight="Normal" FontSize="14"/>
            <ComboBox Grid.Column="1" x:Name="cbSchedule" Height="30" VerticalContentAlignment="Center"
                      SelectionChanged="cbSchedule_SelectionChanged"/>
        </Grid>

        <!-- DataGrid (4 columns matching whiteboard) -->
        <DataGrid Grid.Row="2" x:Name="dgAttendance" Margin="0,0,0,15"
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="All"
                  RowHeight="32"
                  FontSize="13"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <!-- Cột 1: Mã SV -->
                <DataGridTextColumn Header="Mã SV" Binding="{Binding RollNumber}" Width="120" IsReadOnly="True"/>
                
                <!-- Cột 2: Tên sinh viên -->
                <DataGridTextColumn Header="Tên sinh viên" Binding="{Binding FullName}" Width="*" IsReadOnly="True"/>
                
                <!-- Cột 3: Điểm danh (cho phép sửa: CheckBox Có mặt / Vắng) -->
                <DataGridTemplateColumn Header="Điểm danh" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="85">
                                <CheckBox IsChecked="{Binding IsPresent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                          Content="{Binding StatusText}" 
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Cột 4: Ghi chú -->
                <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Save Button (aligned right under table) -->
        <Button Grid.Row="3" x:Name="btnSave" Content="Save" Width="100" Height="32" 
                HorizontalAlignment="Right" Margin="0,0,5,0"
                Click="btnSave_Click"/>
    </Grid>
</Window>
